# Copy this file to .env.local for local testing. On Vercel, add each one under Settings → Environment Variables.

# Your website address, no slash at the end (e.g. https://theexecutionlog.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret! Never share it or put it in front-end code.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (use the test keys first: sk_test_...)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Stripe → Product catalogue → each plan's monthly price ID (price_...)
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
# Free trial length for first-time subscribers
TRIAL_DAYS=7

# Resend → API Keys
RESEND_API_KEY=
EMAIL_FROM="The Execution Log <hello@yourdomain.com>"

# AI Trading Coach (Elite): console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional: model and daily coach requests per Elite user
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=30
